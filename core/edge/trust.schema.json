{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeptempo.ai/edge/trust/v1",
  "title": "Vigil edge trust: DSSE envelope and edge trust root v1",
  "description": "Every edge artefact (containment-policy pack, edge trust root) travels as a DSSE envelope. The trust root says which keys may sign which payload types. Verification: core/edge/verify.py — ported from the Medic trust pattern (services/medic/contracts/trust_check.py); Medic itself is untouched.",
  "$ref": "#/$defs/envelope",
  "$defs": {
    "b64": {"type": "string", "pattern": "^[A-Za-z0-9+/]*={0,2}$"},
    "keyid": {"description": "First 32 hex of sha256(raw 32-byte public key).", "type": "string", "pattern": "^[0-9a-f]{32}$"},
    "ts": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "payload_type": {
      "enum": [
        "application/vnd.deeptempo.vigil.edge-policy.v1+json",
        "application/vnd.deeptempo.vigil.edge-trust-root.v1+json"
      ]
    },
    "envelope": {
      "description": "DSSE v1 (https://github.com/secure-systems-lab/dsse). Signatures are over PAE(payloadType, payload bytes).",
      "type": "object",
      "required": ["payloadType", "payload", "signatures"],
      "additionalProperties": false,
      "properties": {
        "payloadType": {"$ref": "#/$defs/payload_type"},
        "payload": {"$ref": "#/$defs/b64"},
        "signatures": {
          "type": "array", "minItems": 1, "maxItems": 8,
          "items": {
            "type": "object", "required": ["keyid", "sig"], "additionalProperties": false,
            "properties": {"keyid": {"$ref": "#/$defs/keyid"}, "sig": {"$ref": "#/$defs/b64", "maxLength": 128}}
          }
        }
      }
    },
    "role": {
      "type": "object",
      "required": ["keyids", "threshold", "payload_types"],
      "additionalProperties": false,
      "properties": {
        "keyids": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/keyid"}},
        "threshold": {"type": "integer", "minimum": 1, "maximum": 8},
        "payload_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/payload_type"}}
      }
    },
    "trust_root": {
      "description": "The payload of an edge trust-root envelope. TUF-shaped: versioned, expiring, threshold-signed by the root role. Unlike Medic's root there is no channel machinery — an edge pack either verifies or does not.",
      "type": "object",
      "required": ["format", "version", "issued_at", "expires_at", "keys", "roles", "revoked_keyids"],
      "additionalProperties": false,
      "properties": {
        "format": {"const": "vigil.edge-trust-root/v1"},
        "version": {"description": "Strictly increasing.", "type": "integer", "minimum": 1},
        "issued_at": {"$ref": "#/$defs/ts"},
        "expires_at": {"description": "Rotation must happen inside 400 days (MAX_ROOT_LIFETIME_DAYS).", "$ref": "#/$defs/ts"},
        "keys": {
          "type": "object", "maxProperties": 32,
          "propertyNames": {"$ref": "#/$defs/keyid"},
          "additionalProperties": {
            "type": "object", "required": ["alg", "public", "not_after", "holder"], "additionalProperties": false,
            "properties": {
              "alg": {"const": "ed25519"},
              "public": {"$ref": "#/$defs/b64", "minLength": 44, "maxLength": 44},
              "not_after": {"description": "Signatures by this key stop verifying after this time (rotation overlap).", "$ref": "#/$defs/ts"},
              "holder": {"description": "Where the private key lives, e.g. 'aws-kms:edge-policy-2026' or 'yubikey:root-1'. Informational.", "type": "string", "pattern": "^[a-z0-9-]+:[A-Za-z0-9._-]{1,64}$"}
            }
          }
        },
        "roles": {
          "type": "object",
          "required": ["root", "policies"],
          "additionalProperties": false,
          "properties": {
            "root": {"$ref": "#/$defs/role"},
            "policies": {"description": "The role that signs containment-policy packs.", "$ref": "#/$defs/role"}
          }
        },
        "revoked_keyids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/keyid"}}
      }
    }
  }
}
