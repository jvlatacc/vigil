{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeptempo.ai/vigil/edge/contracts/edge-trust-root/v1",
  "title": "Vigil edge trust root v1",
  "description": "The offline trust store an edge daemon verifies bundle envelopes against (design spec art_CRPCjz0X). TUF-shaped like medic's trust root (services/medic/contracts/trust.schema.json): versioned, expiring, keys scoped to roles by payload type. The daemon ships this document; nothing fetches it at runtime.",
  "type": "object",
  "required": [
    "format",
    "version",
    "issued_at",
    "expires_at",
    "keys",
    "roles",
    "revoked_keyids"
  ],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "vigil.edge.trust-root/v1" },
    "version": {
      "description": "Strictly increasing; a newer root replaces an older one wholesale.",
      "type": "integer",
      "minimum": 1
    },
    "issued_at": { "$ref": "#/$defs/ts" },
    "expires_at": {
      "description": "When the trust root itself expires. Verification past this point fails — rotation is a signed operation, never a local extension.",
      "$ref": "#/$defs/ts"
    },
    "keys": {
      "description": "keyid (first 32 hex of sha256 of the raw Ed25519 public key) to key material, base64 raw public bytes.",
      "type": "object",
      "maxProperties": 32,
      "propertyNames": { "pattern": "^[0-9a-f]{32}$" },
      "additionalProperties": {
        "type": "object",
        "required": ["public", "not_after"],
        "additionalProperties": false,
        "properties": {
          "public": { "$ref": "#/$defs/b64" },
          "not_after": { "$ref": "#/$defs/ts" }
        }
      }
    },
    "roles": {
      "description": "Which keys may sign which payload types. v1 ships exactly one role: bundles.",
      "type": "object",
      "required": ["bundles"],
      "additionalProperties": false,
      "properties": {
        "bundles": {
          "type": "object",
          "required": ["keyids", "threshold", "payload_types"],
          "additionalProperties": false,
          "properties": {
            "keyids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/keyid" }
            },
            "threshold": {
              "description": "Distinct valid signatures required. 1 for v1.",
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            },
            "payload_types": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "application/vnd.deeptempo.vigil.edge-bundle.v1+json"
                ]
              }
            }
          }
        }
      }
    },
    "revoked_keyids": {
      "type": "array",
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/keyid" }
    }
  },
  "$defs": {
    "b64": { "type": "string", "pattern": "^[A-Za-z0-9+/]*={0,2}$" },
    "keyid": {
      "description": "First 32 hex of sha256(raw 32-byte public key).",
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "ts": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
